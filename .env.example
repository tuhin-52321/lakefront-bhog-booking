# URL of the Apps Script Web App deployment (doPost endpoint) that appends
# bookings to the "Form Responses 1" sheet. Get this from Apps Script ->
# Deploy -> Manage deployments -> Web app URL, after running fixBooking8/
# deploying the doPost handler described in the Bhog Coupon Booking Form Builder
# Apps Script project.
SHEETS_WEBAPP_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXXX/exec

# Shared secret that must match the SECRET constant set in the Apps Script's
# doPost handler. Prevents random people from posting fake bookings straight
# to the Apps Script endpoint. Generate any random string for this.
SUBMIT_SECRET=change-me-to-a-random-string
